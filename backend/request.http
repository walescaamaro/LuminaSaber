# request.http
# Testes da API — LuminaSaber
# Extensão necessária: REST Client (VSCode)
# Antes de rodar, inicie o servidor em http://localhost:3000
# Execute npm run migrate e npm run seed se precisar resetar o banco.

### ─── GET (CONSULTAS) ───────────────────────────────────────────────

### Listar todas as questões → 200
GET http://localhost:3000/api/questoes
Accept: application/json

### Buscar questão existente por ID → 200
GET http://localhost:3000/api/questoes/11154
Accept: application/json

### Buscar questão inexistente → 404
GET http://localhost:3000/api/questoes/99999
Accept: application/json

### Buscar questão com ID inválido (não numérico) → 400
GET http://localhost:3000/api/questoes/abc
Accept: application/json


### ─── POST (CRIAÇÃO) ────────────────────────────────────────────────

### Criar nova questão válida → 201
POST http://localhost:3000/api/questoes
Content-Type: application/json

{
  "cod_disc": 82211,
  "enunciado": "Quanto é 9 × 9?",
  "alternativa_A": "81",
  "alternativa_B": "72",
  "alternativa_C": "63",
  "alternativa_D": "90",
  "alternativa_correta": "a",
  "dificuldade": "fácil"
}

### Criar questão com campos obrigatórios faltando → 400
POST http://localhost:3000/api/questoes
Content-Type: application/json

{
  "cod_disc": 82211,
  "enunciado": "Questão incompleta",
  "alternativa_A": "10"
}

### Criar questão com alternativa_correta inválida → 400
POST http://localhost:3000/api/questoes
Content-Type: application/json

{
  "cod_disc": 82211,
  "enunciado": "Quanto é 4 + 4?",
  "alternativa_A": "6",
  "alternativa_B": "7",
  "alternativa_C": "8",
  "alternativa_D": "9",
  "alternativa_correta": "z",
  "dificuldade": "fácil"
}


### ─── PUT (ATUALIZAÇÃO) ─────────────────────────────────────────────

### Atualizar enunciado e dificuldade de uma questão → 200
PUT http://localhost:3000/api/questoes/11154
Content-Type: application/json

{
  "enunciado": "Quanto é 8 + 7? (revisado)",
  "dificuldade": "médio"
}

### Atualizar alternativa correta e dificuldade de outra questão → 200
PUT http://localhost:3000/api/questoes/22468
Content-Type: application/json

{
  "alternativa_correta": "b",
  "dificuldade": "médio"
}

### Atualizar questão que não existe → 404
PUT http://localhost:3000/api/questoes/99999
Content-Type: application/json

{
  "enunciado": "Questão que não existe"
}

### Atualizar sem enviar nenhum campo (vazio) → 400
PUT http://localhost:3000/api/questoes/11154
Content-Type: application/json

{}


### ─── DELETE (REMOÇÃO) ──────────────────────────────────────────────

### Deletar questão existente → 200
DELETE http://localhost:3000/api/questoes/90003
Accept: application/json

### Deletar questão que não existe → 404
DELETE http://localhost:3000/api/questoes/99999
Accept: application/json

### Deletar com ID inválido (não numérico) → 400
DELETE http://localhost:3000/api/questoes/xyz
Accept: application/json

### ─── AUTENTICAÇÃO (USUÁRIOS) ────────────────────────────────────────

### Cadastro válido → 201
POST http://localhost:3000/api/usuarios
Content-Type: application/json

{
  "nome": "Aluno Teste",
  "email": "aluno.teste2@luminasaber.com",
  "senha": "SenhaForte123",
  "grau_escolar": "5º ano",
  "data_nasc": "2014-03-10",
  "tipo": "aluno"
}

### Cadastro com e-mail já existente → 409 (rode o bloco acima 2x pra ver)
POST http://localhost:3000/api/usuarios
Content-Type: application/json

{
  "nome": "Aluno Teste",
  "email": "aluno.teste2@luminasaber.com",
  "senha": "OutraSenha456",
  "grau_escolar": "5º ano",
  "data_nasc": "2014-03-10",
  "tipo": "aluno"
}

### Cadastro com campos obrigatórios faltando → 400
POST http://localhost:3000/api/usuarios
Content-Type: application/json

{
  "email": "incompleto@luminasaber.com",
  "senha": "123456"
}


### Login válido → 200, retorna o token JWT
# @name login
POST http://localhost:3000/api/usuarios/login
Content-Type: application/json

{
  "email": "aluno.teste2@luminasaber.com",
  "senha": "SenhaForte123"
}

### Login com senha incorreta → 401
POST http://localhost:3000/api/usuarios/login
Content-Type: application/json

{
  "email": "aluno.teste2@luminasaber.com",
  "senha": "senhaErrada"
}

### Login com usuário inexistente → 401
POST http://localhost:3000/api/usuarios/login
Content-Type: application/json

{
  "email": "naoexiste@luminasaber.com",
  "senha": "qualquercoisa"
}


### Acessar rota protegida SEM token → 401
GET http://localhost:3000/api/usuarios/perfil
Accept: application/json

### Acessar a MESMA rota protegida usando o token do login acima → 200
GET http://localhost:3000/api/usuarios/perfil
Authorization: Bearer {{login.response.body.token}}
Accept: application/json


### Anotações do usuário logado SEM token → 401
GET http://localhost:3000/api/anotacoes
Accept: application/json

### Anotações do usuário logado COM token → 200
GET http://localhost:3000/api/anotacoes
Authorization: Bearer {{login.response.body.token}}
Accept: application/json

### Histórico do usuário logado COM token → 200
GET http://localhost:3000/api/historico
Authorization: Bearer {{login.response.body.token}}
Accept: application/json

### Logout (rota protegida) COM token → 200
POST http://localhost:3000/api/usuarios/logout
Content-Type: application/json
Authorization: Bearer {{login.response.body.token}}
Accept: application/json