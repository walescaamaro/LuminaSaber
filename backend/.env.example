DATABASE_URL="file:./src/database/db.sqlite"
GEMINI_API_KEY=sua_chave_aqui
JWT_SECRET=troque-por-um-segredo-aleatorio-com-pelo-menos-32-caracteres
GROQ_API_KEY=sua_chave_aqui

# NODE_ENV=development usa uma conta de teste descartável do Ethereal
# automaticamente (deixe EMAIL_USER e EMAIL_PASS vazios enquanto estuda) —
# é o que decide entre o SMTP real configurado abaixo e o Ethereal.
NODE_ENV=development

# SMTP do envio de e-mail transacional (config/mail.ts + services/SendMail.ts).
# Em desenvolvimento pode deixar tudo vazio: o Ethereal assume sozinho.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=
EMAIL_PASS=