{
  "name": "luminasaber-backend",
  "version": "1.0.0",
  "type": "module",
  "description": "Back-end para a plataforma LuminaSaber",
  "main": "server.ts",
  "scripts": {
    "start": "tsx server.ts",
    "dev": "tsx watch server.ts",
    "prisma:generate": "prisma generate",
    "prisma:push": "prisma db push",
    "migrate": "tsx src/database/migration.ts",
    "seed": "tsx src/database/seed.ts",
    "check": "tsc --noEmit && tsc --noEmit -p tsconfig.e2e.json",
    "test:files": "node scripts/gerar-arquivos-teste.mjs",
    "test": "npm run test:unit && npm run test:api",
    "test:unit": "node --import tsx --test src/__tests__/auth.test.ts src/__tests__/validation.test.ts src/__tests__/business.test.ts src/__tests__/controllers.test.ts src/__tests__/database.test.ts",
    "test:api": "node scripts/run-api-tests.mjs",
    "front:test": "vitest run",
    "front:coverage": "vitest run --coverage",
    "e2e": "node scripts/run-e2e.mjs",
    "coverage:backend": "c8 --all --include 'src/**/*.ts' --exclude 'src/__tests__/**' --exclude 'src/types/**' --exclude 'src/database/seed.ts' --exclude 'src/database/migration.ts' --reporter=text --reporter=html --reports-dir coverage/backend --check-coverage --lines 80 --functions 80 --branches 80 --statements 80 npm test",
    "coverage": "npm run coverage:backend && npm run front:coverage"
  },
  "dependencies": {
    "@prisma/adapter-better-sqlite3": "^7.9.0",
    "@prisma/client": "^7.8.0",
    "argon2": "^0.45.1",
    "better-sqlite3": "^12.10.0",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.4.2",
    "express": "^4.18.4",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.0.2",
    "morgan": "^1.10.1",
    "nodemailer": "^10.0.10",
    "zod": "^4.5.4"
  },
  "engines": {
    "node": "^20.19.0 || ^22.12.0 || >=24.0.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^4.17.18",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/multer": "^2.0.0",
    "@types/morgan": "^1.9.4",
    "@types/node": "^26.1.1",
    "@types/nodemailer": "^8.0.2",
    "@types/supertest": "^6.0.3",
    "@playwright/test": "^1.55.0",
    "@vitest/coverage-v8": "^3.2.4",
    "c8": "^10.1.3",
    "jsdom": "^26.1.0",
    "prisma": "^7.8.0",
    "supertest": "^7.1.4",
    "tsx": "^3.12.3",
    "typescript": "^5.6.2",
    "vitest": "^3.2.4"
  }
}
