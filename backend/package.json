{
  "name": "luminasaber-backend",
  "version": "1.0.0",
  "type": "module",
  "description": "Back-end para a plataforma LuminaSaber",
  "main": "server.ts",
  "scripts": {
    "start": "tsx server.ts",
    "dev": "tsx watch server.ts",
    "migrate": "tsx src/database/migration.ts",
    "seed": "tsx src/database/seed.ts",
    "check": "tsc --noEmit"
  },
  "dependencies": {
    "better-sqlite3": "^12.10.0",
    "express": "^4.18.4",
    "morgan": "^1.10.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/express": "^4.17.18",
    "@types/morgan": "^1.9.4",
    "@types/node": "^20.11.0",
    "tsx": "^3.12.3",
    "typescript": "^5.6.2"
  }
}
